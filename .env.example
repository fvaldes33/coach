# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# TypeSafe (Jev) — fast intent routing. Optional: without it, only an exact
# "where am I today?" hits the dashboard fast path; everything else goes to the worker.
TYPESAFE_API_KEY=

# Optional: free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY is rate-limited)
USDA_API_KEY=

# Worker: claude (default) or codex. Model override is optional.
COACH_WORKER=
COACH_WORKER_MODEL=
